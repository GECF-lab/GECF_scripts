multi_libraries () {

	#usage multi_libraries $multi_type(=multiGEX etc) $feature_types_multi
	
	for ((zz=1; zz<= $manyfastq; zz++))
	do
		fastqpath="\$fastqpath$zz"	#to escape $ symbol	
		currentpath=($(awk -v var=$fastqpath 'BEGIN {FS="\t"};  $1 == var {print $3}'  ${current_datasheet}))
		testpathback=${currentpath: -1}	# defines the last charcater of the string
		testpathfront=${currentpath::1}	# defines the first charcater of the string

		if [ "$testpathfront" != '/' ];		#adds / in front if missing
		then
			currentpath=/${currentpath}
		fi
			
		if [ "$testpathback" = '/' ];		#removes / in the back if present
		then
			currentpath=${currentpath%/}
		fi

			
		completecurrentpath=(${currentpath}/*/${1}_S*_R1_001.fastq.gz)
		completecurrentpath=(${completecurrentpath%/*})
		echo "${1},${completecurrentpath},${2},${subsample_rate_option}" >> multi-config_${library_name}.csv
	done
	

}


multi_final_file () {
	
	#usage multi_final_file $library_name

	#[gene expression or other feature]
	multi_feature_file $1
	
	#[libraries]

	echo "[libraries]" >> multi-config_${1}.csv
	echo "fastq_id,fastqs,feature_types,subsample_rate" >> multi-config_${1}.csv

	if [ -n "$multi_GEX" ];
	then
		feature_types_multi=("gene expression")
		multi_libraries $multi_GEX "$feature_types_multi"	#"$feature_types_multi" is with "" as it contains a space
	fi

	if [ -n "$multi_VDJ" ];
	then
		feature_types_multi=vdj
		multi_libraries $multi_VDJ $feature_types_multi
	fi
	
	if [ -n "$multi_VDJ_T" ];
	then
		feature_types_multi=vdj-t
		multi_libraries $multi_VDJ_T $feature_types_multi
	fi
	
	if [ -n "$multi_VDJ_B" ];
	then
		feature_types_multi=vdj-b
		multi_libraries $multi_VDJ_B $feature_types_multi
	fi
	
	if [ -n "$multi_Ab" ];
	then
		feature_types_multi=("antibody capture")
		multi_libraries $multi_Ab "$feature_types_multi"

	fi
	
	if [ -n "$multi_CRISPR" ];
	then
		feature_types_multi=("crispr guide capture")
		multi_libraries $multi_CRISPR "$feature_types_multi"
	fi

	if [ -n "$multi_Cellplex" ];
	then
		feature_types_multi=("Multiplexing Capture")
		multi_libraries $multi_Cellplex "$feature_types_multi"
	fi

	echo "" >> multi-config_${1}.csv

	#Multiplexing with TotalSeq or Cellplex, section [samples]

	if test "$totalseq" != 'no';	
	then
		echo "[samples]" >> multi-config_${1}.csv
		echo "sample_id,hashtag_ids" >> multi-config_${1}.csv

		if test "$totalseq_type" = 'Human';	
		then
			htype=Hu
		elif test "$totalseq_type" = 'Mouse';	
		then
			htype=Ms
		elif test "$totalseq_type" = 'Nuclear';	
		then
			htype=Nuclear
		fi

		
		for tag in {1..24}
		do
			tagn="hashtag${tag}s"
			tag_samplename=$(echo "${!tagn}" | tr -d '[:space:]') # Remove ALL whitespace, including tabs and newlines
			#tag_samplename="${!tagn}"	#to obtain the value store in hashtagxxx variable
				
			if [ -n "$tag_samplename" ];
			then
				if test $tag -ge 16;
				then
					if test "$totalseq_type" = 'Mouse';
					then
						htype=Mu
					fi
				fi
				
				echo "${tag_samplename},${htype}_Hashtag_${tag}" >> multi-config_${1}.csv
			fi	

		done
	fi

	

	if test "$ocmexp" != 'no';	
	then
		echo "[samples]" >> multi-config_${1}.csv
		echo "sample_id,ocm_barcode_ids,force_cells" >> multi-config_${1}.csv
		
		declare -A seen_ocm  # track sample names already written

		for i in 1 2 3 4; 
		do
    			ocmn="OCM${i}s"
    			ocm_samplename="${!ocmn}"
    			forcen="OCM${i}_force"
 			ocm_force="${!forcen}"

    			[ -z "$ocm_samplename" ] && continue          # skip if empty
    			[ -n "${seen_ocm[$ocm_samplename]}" ] && continue  # skip if already written

   			# collect all OB indices that share this sample name
    			ob_ids=""
    			for j in 1 2 3 4; 
			do
        			ocmj="OCM${j}s"
        			[ "${!ocmj}" = "$ocm_samplename" ] && ob_ids="${ob_ids:+${ob_ids}|}OB${j}"

				#${ob_ids:+${ob_ids}|} is a bash trick that prepends the | separator only when ob_ids is already non-empty, avoiding a leading |
    			done

    			echo "${ocm_samplename},${ob_ids},${ocm_force}" >> multi-config_${1}.csv
    			seen_ocm[$ocm_samplename]=1
		done

		unset seen_ocm

	fi

}

CR_multi () {

	#usage CR_multi $library_name $q or other variable for sample number

	echo "CRmulti script version: ${scriptversion}" >> ${1}_script_log.txt
	cat "${multi-config_${1}.csv}"
	
	if test "$commandoutputonlyfirstletter" != 'y';	
	then
		echo "cellranger multi --id=${1} --csv=multi-config_${1}.csv --localcores=30 --localmem=100"  >>  ${1}_script_log.txt
		cellranger multi --id=${1} --csv=multi-config_${1}.csv --localcores=30 --localmem=100
		rm -r ${pathcount}/${1}/SC_MULTI_CS
		find ${pathcount}/${1} -type d -name "tmp" -print >> ${pathcount}/${1}_error_log.txt	#look for tmp folders (to see if all count have completed)
		if [ -s  ${pathcount}/${1}_error_log.txt ];
		then
			echo "Error: CR multi didn't complete."
		else
			rm ${pathcount}/${1}_error_log.txt
		fi

		

		# Rename hashtag per-sample output folders to include their index number
		if [ -n "$totalseq" ] && [ "$totalseq" != "no" ]; 
		then
    			per_sample_dir="${pathcount}/${1}/outs/per_sample_outs"
   			if [ -d "$per_sample_dir" ]; 
			then
        			for tag in {1..24}
       				do
            				tagn="hashtag${tag}s"
            				tag_samplename=$(echo "${!tagn}" | tr -d '[:space:]')
            				if [ -n "$tag_samplename" ] && [ -d "${per_sample_dir}/${tag_samplename}" ]; 
					then
                				mv "${per_sample_dir}/${tag_samplename}" "${per_sample_dir}/${tag}_${tag_samplename}"
                				echo "Renamed: ${tag_samplename} -> ${tag}_${tag_samplename}" >> ${1}_script_log.txt
            				fi
        			done
    			fi
		fi
	

		# Rename OCM per-sample output folders to include their index number
		if [ -n "$ocmexp" ] && [ "$ocmexp" != "no" ]; 
		then
    			per_sample_dir="${pathcount}/${1}/outs/per_sample_outs"
    			if [ -d "$per_sample_dir" ]; 
			then
        			for i in 1 2 3 4; 
				do
            				ocmn="OCM${i}s"
            				ocm_samplename=$(echo "${!ocmn}" | tr -d '[:space:]')
            				if [ -n "$ocm_samplename" ] && [ -d "${per_sample_dir}/${ocm_samplename}" ]; 
					then
                				mv "${per_sample_dir}/${ocm_samplename}" "${per_sample_dir}/${i}_${ocm_samplename}"
          				      echo "Renamed: ${ocm_samplename} -> ${i}_${ocm_samplename}" >> ${1}_script_log.txt
            				fi
        			done
    			fi
		fi


		#numbering
		mv ${pathcount}/${1} ${pathcount}/${2}_${1}

		#md5 checksum
		find ${pathcount}/${2}_${1} -type f | sort | xargs md5sum | sed "s|$pathcount||" > ${pathcount}/md5_checksum/${2}_${1}_md5_checksum.txt
		rsync -avh ${pathcount}/md5_checksum/${2}_${1}_md5_checksum.txt ${sv1files}/${nxtorhsq}/ZZ_10XG/multi/${run_name}_${username}_${timestamp}/md5_checksum



		#qc report folder
		mkdir -p ${pathcount}/Summary_multi/${2}_${1}_qc
		cp ${pathcount}/${2}_${1}/outs/qc_report.html ${pathcount}/Summary_multi/${2}_${1}_qc/${2}_${1}_qc_report.html
		cp ${pathcount}/${2}_${1}/outs/qc_sample_metrics.csv ${pathcount}/Summary_multi/${2}_${1}_qc/${2}_${1}_qc_sample_metrics.csv
		cp ${pathcount}/${2}_${1}/outs/qc_library_metrics.csv ${pathcount}/Summary_multi/${2}_${1}_qc/${2}_${1}_qc_library_metrics.csv		

		
