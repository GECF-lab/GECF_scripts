	ocmexp=$(awk 'BEGIN {FS="\t"}; /ocmexp/{print $3}' $1)
	totalseq=$(awk 'BEGIN {FS="\t"}; /totalseq/{print $3}' $1)
	minimumUMI=$(awk 'BEGIN {FS="\t"}; /minimumUMI/{print $3}' $1)
	minimumUMI=$(echo $minimumUMI | tr -d ' ')	#remove white spaces
	R1length=$(awk 'BEGIN {FS="\t"}; /R1length/{print $3}' $1)
	R1length=$(echo $R1length | tr -d ' ')	#remove white spaces
	R2length=$(awk 'BEGIN {FS="\t"}; /R2length/{print $3}' $1)
	R2length=$(echo $R2length | tr -d ' ')	#remove white spaces
	R1length_VDJ=$(awk 'BEGIN {FS="\t"}; /R1length_VDJ/{print $3}' $1)
	R1length_VDJ=$(echo $R1length_VDJ | tr -d ' ')	#remove white spaces
	R2length_VDJ=$(awk 'BEGIN {FS="\t"}; /R2length_VDJ/{print $3}' $1)
	R2length_VDJ=$(echo $R2length_VDJ | tr -d ' ')	#remove white spaces
