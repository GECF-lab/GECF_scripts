	R1length_FB=$(echo $R1length_FB | tr -d ' ')	#remove white spaces
	R2length_FB=$(awk 'BEGIN {FS="\t"}; /R2length_FB/{print $3}' $1)
	R2length_FB=$(echo $R2length_FB | tr -d ' ')	#remove white spaces
	
}



datasheet_sample_var_def () {		

	#usage: datasheet_sample_var_def $currentsample $current_datasheet
	# $1 = sample variable (e.g. "\$sample1"), $2 = datasheet file

	library_name=$(awk -v var=$1 'BEGIN {FS="\t"}; $1==var {print $2}' $2 | tr -d ' ')
	expect_cells=$(awk -v var=$1 'BEGIN {FS="\t"}; $1==var {print $3}' $2 | tr -d "\' ")
	force_cells=$(awk -v var=$1 'BEGIN {FS="\t"}; $1==var {print $4}' $2 | tr -d "\' ")
	chemistry=$(awk -v var=$1 'BEGIN {FS="\t"}; $1==var {print $5}' $2 | tr -d ' ')

	introns_raw=$(awk -v var=$1 'BEGIN {FS="\t"}; $1==var {print $6}' $2)
	[ "$introns_raw" = 'FALSE' ] && introns_option=false || introns_option=true

	bam_raw=$(awk -v var=$1 'BEGIN {FS="\t"}; $1==var {print $7}' $2)
	[ "$bam_raw" = 'FALSE' ] && bam_settings=false || bam_settings=true

	transcriptome=$(awk -v var=$1 'BEGIN {FS="\t"}; $1==var {print $8}' $2)
	transcriptome_custom=$(awk -v var=$1 'BEGIN {FS="\t"}; $1==var {print $9}' $2 | tr -d ' ')
	subsample_rate_option=$(awk -v var=$1 'BEGIN {FS="\t"}; $1==var {print $10}' $2 | tr -d ' ')

	pathFB_refCSV=$(awk -v var=$1 'BEGIN {FS="\t"}; $1==var {print $11}' $2 | tr -d ' ')
	if [ -n "$pathFB_refCSV" ]; then
		pathFB_refCSV=${pathFB_refCSV%.csv}.csv		# normalize .csv extension
	fi

	multi_GEX=$(awk -v var=$1 'BEGIN {FS="\t"}; $1==var {print $12}' $2 | tr -d ' ')
	multi_VDJ=$(awk -v var=$1 'BEGIN {FS="\t"}; $1==var {print $13}' $2 | tr -d ' ')
	multi_VDJ_T=$(awk -v var=$1 'BEGIN {FS="\t"}; $1==var {print $14}' $2 | tr -d ' ')
	multi_VDJ_B=$(awk -v var=$1 'BEGIN {FS="\t"}; $1==var {print $15}' $2 | tr -d ' ')
	multi_Ab=$(awk -v var=$1 'BEGIN {FS="\t"}; $1==var {print $16}' $2 | tr -d ' ')
	multi_CRISPR=$(awk -v var=$1 'BEGIN {FS="\t"}; $1==var {print $17}' $2 | tr -d ' ')
	
	# TotalSeq hashtag variables (cols 19-42)
	if [ -n "$totalseq" ] && [ "$totalseq" != "no" ]; then
		totalseq_type=$(awk -v var=$1 'BEGIN {FS="\t"}; $1==var {print $18}' $2)
		for tag in {1..24}; do
			val=$(awk -v var=$1 -v col=$((18+tag)) 'BEGIN {FS="\t"}; $1==var {print $col}' $2 | tr -d ' ')
			printf -v "hashtag${tag}s" '%s' "$val"
		done
	fi


	# OCM variables (cols 43-46 for values, 47-50 for force)
	for i in 1 2 3 4; do
		val=$(awk -v var=$1 -v col=$((42+i)) 'BEGIN {FS="\t"}; $1==var {print $col}' $2 | tr -d ' \r\n')
		printf -v "OCM${i}s" '%s' "$val"
		val=$(awk -v var=$1 -v col=$((46+i)) 'BEGIN {FS="\t"}; $1==var {print $col}' $2 | tr -d ' \r\n')
		printf -v "OCM${i}_force" '%s' "$val"
	done

	

	if [ -n "$transcriptome" ]; 
	then
		transcriptome=${transcriptome% (*)}
	fi

	transcriptome_custom_length=${#transcriptome_custom}		#defines the length of the string. since it save something even if the cell is empty but the tab is activated in txt file
	
	if [ "$transcriptome_custom_length" -gt '1' ] && [ "$transcriptome_custom" != 'no' ]; 
	then
		testpathfront=${transcriptome_custom::1} # defines the first charcater of the string
		testpathback=${transcriptome_custom: -1} # defines the last charcater of the string
		[ "$testpathback" != '/' ] && transcriptome_custom=${transcriptome_custom}/
		[ "$testpathfront" != '/' ] && transcriptome_custom=/${transcriptome_custom}
		echo "Custom transcriptome is present: ${transcriptome_custom}"
	fi

}



