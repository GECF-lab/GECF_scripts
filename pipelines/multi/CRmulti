############################################
#WEBSUMMARIES COPY AND CREATE SUMMARY METRICS FILE
############################################

multi_summary () {

	#usage multi_summary $pathcount


	mkdir -p ${1}/Summary_multi/web_summaries
	mkdir -p ${1}/Summary_multi/csv_summaries

	for current_sample_folder in ${1}/*/outs/per_sample_outs/* ;
	do
		if test -f "${current_sample_folder}/web_summary.html";
		then
		
			#rename and copy websummary
			pooledsamplename=(${current_sample_folder}/web_summary.html)
			pooledsamplename=${pooledsamplename%/*}				#remove the shortest match "/web_summary.html" from the back
			pooledsamplename=${pooledsamplename##*/}						#remove the longest match "*/" from the front
			currentsamplefolder_name=(${current_sample_folder}/web_summary.html)
			currentsamplefolder_name=${currentsamplefolder_name%/outs/per_sample_outs/${pooledsamplename}/web_summary.html}
			currentsamplefolder_name=${currentsamplefolder_name##*/}
			cp ${current_sample_folder}/web_summary.html ${1}/Summary_multi/web_summaries/${currentsamplefolder_name}_${pooledsamplename}_web_summary.html

			#rename and copy metrcis csv
			cp ${current_sample_folder}/metrics_summary.csv ${1}/Summary_multi/csv_summaries/${currentsamplefolder_name}_${pooledsamplename}_metrics_summary.csv


		fi

		
	done

	mkdir ${1}/Summary_multi/csv_summaries/modified_metrics
	modified_metrics_folder=(${1}/Summary_multi/csv_summaries/modified_metrics)

	for file in ${pathcount}/Summary_multi/csv_summaries/*.csv; 
	do
    		filename=${file%_metrics_summary.csv}
   		filename=${filename##*/}

 	  	out_file="${modified_metrics_folder}/${filename}_modified_metrics.csv"

    		while IFS= read -r line; do
        		 # Step 1: Collapse all commas inside quoted numeric fields
        		cleaned=$(echo "$line" | sed -E ':a;s/"([0-9]+),([0-9,]+)([^"]*)"/"\1\2\3"/g;ta')

     			 # Step 2: Strip anything after the first non-digit in quoted fields
     			 cleaned=$(echo "$cleaned" | sed -E 's/"([0-9]+)[^0-9]*[^"]*"/"\1"/g')

        		 # Step 3: Remove quotes around pure numeric values
 		         cleaned=$(echo "$cleaned" | sed -E 's/"([0-9]+)"/\1/g')
	        	
			echo "$cleaned"
    		done < "$file" > "$out_file"
		
		# Continue with your string replacements
    		sed 's/Cells with productive V-J spanning (IGK, IGH) pair/Cells with productive V-J spanning (IGK-IGH) pair/g' ${modified_metrics_folder}/${filename}_modified_metrics.csv > ${modified_metrics_folder}/${filename}_modified_metrics2.csv
  		sed 's/Cells with productive V-J spanning (IGL, IGH) pair/Cells with productive V-J spanning (IGK-IGH) pair/g' ${modified_metrics_folder}/${filename}_modified_metrics2.csv > ${modified_metrics_folder}/${filename}_modified_metrics3.csv
		
	done

	rm ${modified_metrics_folder}/*_modified_metrics.csv
	rm ${modified_metrics_folder}/*_modified_metrics2.csv


	input_folder=(${modified_metrics_folder})

	# Define output file
	output_file="SummaryMetrics_temp.csv"

	
	# Get list of CSV files sorted
	csv_files=($(ls "$input_folder"/*.csv | sort))

	if [ ${#csv_files[@]} -eq 0 ]; then
    		echo "No CSV files found in the specified folder."
    		exit 1
	fi

	# Extract the first 5 columns from the first file and store the header
	head -n 1 "${csv_files[0]}" | cut -d',' -f1-5 > header.csv
	cut -d',' -f1-5 "${csv_files[0]}" | tail -n +2 > "$output_file"

	# Prepare the header row
	header_row=$(head -n 1 "${csv_files[0]}" | cut -d',' -f1-5)

	# Extract the 6th column from each file, rename header, and append to output
	for file in "${csv_files[@]}"; 
	do
    		col_name=$(basename "$file" | sed 's/_modified_metrics3.csv//')
    		header_row+=",$col_name"
    		cut -d',' -f6 "$file" | tail -n +2 > temp_col.csv
    		paste -d',' "$output_file" temp_col.csv > temp_output.csv
    		mv temp_output.csv "$output_file"
	done

	# Prepend the corrected header row to the output file
	echo "$header_row" > temp_output.csv
	cat "$output_file" >> temp_output.csv
	mv temp_output.csv "$output_file"

	#replace space with _ for column 5
	awk -F, 'BEGIN {OFS=","} {$5 = gensub(/ /, "_", "g", $5); print}' $output_file > Summary_metrics_multi.csv


	rm temp_col.csv
	rm header.csv
	rm SummaryMetrics_temp.csv
	
	rm -rf ${modified_metrics_folder}

	rsync -avh ${pathcount}/Summary_multi ${sv1files}/${nxtorhsq}/ZZ_10XG/multi/${run_name}_${username}_${timestamp}
	rsync -avh ${pathcount}/Summary_metrics_multi.csv ${sv1files}/${nxtorhsq}/ZZ_10XG/multi/${run_name}_${username}_${timestamp}

	
}


