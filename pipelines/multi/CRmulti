datasheet_exp_var_def () {		#parse the datasheet file and define experiment variables

	#use datasheet_exp_var_def $current_datasheet

	run_name=$(awk 'BEGIN {FS="\t"}; /run_name/{print $3}' $1)
	run_name=$(echo $run_name | tr -d ' ')	#remove white spaces
	username=$(awk 'BEGIN {FS="\t"}; /username/{print $3}' $1)
	username=$(echo $username | tr -d ' ')	#remove white spaces
	commandoutputonly=$(awk 'BEGIN {FS="\t"}; /commandoutputonly/{print $3}' $1)
	commandoutputonly=$(echo $commandoutputonly | tr -d ' ')	#remove white spaces
	commandoutputonlyfirstletter=${commandoutputonly:0:1}	#first letter of yes or no
	keepdata=$(awk 'BEGIN {FS="\t"}; /keepdata/{print $3}' $1)
	keepdata=$(echo $keepdata | tr -d ' ')	#remove white spaces
	manyfastq=$(awk 'BEGIN {FS="\t"}; /manyfastq/{print $3}' $1)
	manyfastq=$(echo $manyfastq | tr -d ' ')	#remove white spaces

	nxtorhsq=${run_name::3}			#first three characters of run_name to understand if nxtseq or hiseq
	
	if test "$nxtorhsq" = 'AVT';
	then
		nxtorhsq=(AVT/AV240401)
	fi
	
}


