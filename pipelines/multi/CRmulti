def_transcriptomepath () {		#define transcriptome path

	#usage def_transcriptomepath $server
	
	if [ "$1" = 'dell' ] || [ "$1" = 'AMD2024' ];
	then
		if [ "$transcriptome_custom_length" -gt '1' ] && [ "$transcriptome_custom" != 'no' ];
		then
			transcriptomepath=(${transcriptome_custom})
		else
		
			if test "$transcriptome" = 'human';
			then
				transcriptomepath=(/home/gecf/references/cellranger_references/current_human/*/)
				vdjreference=(/home/gecf/references/cellranger_references/VDJ_current_human/*/)
	
			elif test "$transcriptome" = 'mouse';
			then 
				transcriptomepath=(/home/gecf/references/cellranger_references/current_mouse/*/)
				vdjreference=(/home/gecf/references/cellranger_references/VDJ_current_mouse/*/)
							
			elif test "$transcriptome" = 'rat';
			then 
				transcriptomepath=(/home/gecf/references/cellranger_references/current_rat/*/)

			elif test "$transcriptome" = 'human_and_mouse';
			then 
				transcriptomepath=(/home/gecf/references/cellranger_references/current_human_and_mouse/*/)
			
			else
				echo "Error: invalid reference transcriptome. Choose one of the given options (case sensitive)"
				exit 1	#exit the script as failure
			fi										
		fi

	elif [ "$1" = 'old' ];
	then
		if [ "$transcriptome_custom_length" -gt '1' ] && [ "$transcriptome_custom" != 'no' ];
		then
			transcriptomepath=(${transcriptome_custom})
		else
			if test "$transcriptome" = 'human';
			then	
				transcriptomepath=(/fastdrive/CellRanger_Genomes/current_human/*/)

			elif test "$transcriptome" = 'mouse';
			then 
				transcriptomepath=(/fastdrive/CellRanger_Genomes/current_mouse/*/)
					
			elif test "$transcriptome" = 'rat';
			then 
				transcriptomepath=(/fastdrive/CellRanger_Genomes/current_rattus/*/)
			
			elif test "$transcriptome" = 'human_and_mouse';
			then 
				transcriptomepath=(/fastdrive/CellRanger_Genomes/current_human_and_mouse/*/)			
							
			else
				echo "Error: invalid reference transcriptome. Choose one of the given options (case sensitive)"
				exit 1	#exit the script as failure
			fi	
		fi

	else
		echo "Please place yourself in the correct folder"
		exit 1	#exit the script as failure
	fi
		
	#echo "Transcriptome path: ${transcriptomepath}"
}


