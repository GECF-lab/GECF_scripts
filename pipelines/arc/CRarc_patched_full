def_transcriptomepath () {		#define transcriptome path

	#usage def_transcriptomepath $server
	
	if [ "$1" = 'AMD2024' ];

	then
		if [ "$transcriptome_custom_length" -gt '1' ] && [ "$transcriptome_custom" != 'no' ];
		then
			transcriptomepath=(${transcriptome_custom})
		else
		
			if test "$transcriptome" = 'human';
			then
				transcriptomepath=(/home/gecf/references/cellranger_references/current_human_arc_ATAC/*/)	
			elif test "$transcriptome" = 'mouse';
			then 
				transcriptomepath=(/home/gecf/references/cellranger_references/current_mouse_arc_ATAC/*/)		
			else
				echo "Error: invalid reference transcriptome. Choose one of the given options (case sensitive)"
				exit 1	#exit the script as failure
			fi										
		fi

	else
		echo "Please place yourself in the correct folder"
		exit 1	#exit the script as failure
	fi
		
	#echo "Transcriptome path: ${transcriptomepath}"
}


config_file () {

	#usage config_file $samplename 
	echo "fastqs,sample,library_type" >> libraries_${1}.csv
	

	for ((m=1; m<= $GEXmanyfastq; m++))
	do
		GEXfastqpath="\$GEXfastqpath$m"	#to escape $ symbol	
		GEXcurrentpath=($(awk -v var=$GEXfastqpath 'BEGIN {FS="\t"};  $1 == var {print $3}'  ${current_datasheet}))
		GEXtestpathback=${GEXcurrentpath: -1}	# defines the last charcater of the string
		GEXtestpathfront=${GEXcurrentpath::1}	# defines the first charcater of the string

		if [ "$GEXtestpathfront" != '/' ];		#adds / in front if missing
		then
			GEXcurrentpath=/${GEXcurrentpath}
		fi
			
		if [ "$GEXtestpathback" = '/' ];		#removes / in the back if present
		then
			GEXcurrentpath=${GEXcurrentpath%/}
		fi

			
		GEXcompletecurrentpath=(${GEXcurrentpath}/*/${GEXlibrary_name}_S*_R1_001.fastq.gz)
		GEXcompletecurrentpath=(${GEXcompletecurrentpath%/*})
		echo "${GEXcompletecurrentpath},$GEXlibrary_name,Gene Expression" >> libraries_${1}.csv
	done

	for ((p=1; p<= $ATACmanyfastq; p++))
	do
		ATACfastqpath="\$ATACfastqpath$p"	#to escape $ symbol	
		ATACcurrentpath=($(awk -v var=$ATACfastqpath 'BEGIN {FS="\t"};  $1 == var {print $3}'  ${current_datasheet}))
		ATACtestpathback=${ATACcurrentpath: -1}	# defines the last charcater of the string
		ATACtestpathfront=${ATACcurrentpath::1}	# defines the first charcater of the string

		if [ "$ATACtestpathfront" != '/' ];		#adds / in front if missing
		then
			ATACcurrentpath=/${ATACcurrentpath}
		fi
			
		if [ "$ATACtestpathback" = '/' ];		#removes / in the back if present
		then
			ATACcurrentpath=${ATACcurrentpath%/}
		fi

			
		ATACcompletecurrentpath=(${ATACcurrentpath}/*/${ATAClibrary_name}_S*_R1_001.fastq.gz)
		ATACcompletecurrentpath=(${ATACcompletecurrentpath%/*})
		echo "${ATACcompletecurrentpath},$ATAClibrary_name,Chromatin Accessibility" >> libraries_${1}.csv
	done

}

CRarc () {

	#usage CRarc $samplename

	echo "CRarc script version: ${scriptversion}" >> ${1}_script_log.txt

	if test "$commandoutputonlyfirstletter" = 'y';	
	then
		echo "cellranger-arc count --id=${1} --description=${GEXnxid},${ATACnxid} --reference=${transcriptomepath} --libraries=libraries_${1}.csv --create-bam=${bam_settings} ${numberofthreads} ${numberofRAM} --cell-annotation-model=auto --tenx-cloud-token-path=/home/gecf/.config/txg/credentials ${optional_argument} && rsync -avh ${pathcount}/ ${sv1files}/${nxtorhsq}/ZZ_10XG/arc/${run_name}${user_tag}_${timestamp}"
		echo "cellranger-arc count --id=${1} --description=${GEXnxid},${ATACnxid} --reference=${transcriptomepath} --libraries=libraries_${1}.csv --create-bam=${bam_settings} ${numberofthreads} ${numberofRAM} --cell-annotation-model=auto --tenx-cloud-token-path=/home/gecf/.config/txg/credentials ${optional_argument} && rsync -avh ${pathcount}/ ${sv1files}/${nxtorhsq}/ZZ_10XG/arc/${run_name}${user_tag}_${timestamp}" >> ${1}_script_log.txt
		mkdir ${sv1files}/${nxtorhsq}/ZZ_10XG/arc/${run_name}${user_tag}_${timestamp}
		rsync -avh ${pathcount}/ ${sv1files}/${nxtorhsq}/ZZ_10XG/arc/${run_name}${user_tag}_${timestamp}

	else
		echo "cellranger-arc count --id=${1} --description=${GEXnxid},${ATACnxid} --reference=${transcriptomepath} --libraries=libraries_${1}.csv --create-bam=${bam_settings} ${numberofthreads} ${numberofRAM} --cell-annotation-model=auto --tenx-cloud-token-path=/home/gecf/.config/txg/credentials ${optional_argument}" >> ${1}_script_log.txt
		cellranger-arc count --id=${1} --description=${GEXnxid},${ATACnxid} --reference=${transcriptomepath} --libraries=libraries_${1}.csv --create-bam=${bam_settings} ${numberofthreads} ${numberofRAM} --cell-annotation-model=auto --tenx-cloud-token-path=/home/gecf/.config/txg/credentials ${optional_argument}
	# NOTE: SC_ATAC_GEX_COUNTER_CS is no longer deleted here.
	# extract_summary_metrics (run after the sample loop) still needs its per-modality
	# web summaries (GEX only: GEX_SUMMARIZE_REPORTS, ATAC only: _SC_ATAC_REPORTER/
	# CREATE_WEBSUMMARY). Deleting them here silently left raw_metrics_folder/GEX_only/
	# and ATAC_only/ empty. It is now removed once, after extraction (v1.4).
		

		find ${pathcount}/${1} -mindepth 2 -maxdepth 2 -type d -name "tmp" -print >> ${pathcount}/${1}_error_log.txt	#look for tmp folders (to see if all count have completed)
		if [ -s  ${pathcount}/${1}_error_log.txt ];
		then
			echo "Error: CRarc didn't complete."
		else
			rm ${pathcount}/${1}_error_log.txt
		fi

		mkdir ${sv1files}/${nxtorhsq}/ZZ_10XG/arc/${run_name}${user_tag}_${timestamp}
		rsync -avh ${pathcount}/${1} ${sv1files}/${nxtorhsq}/ZZ_10XG/arc/${run_name}${user_tag}_${timestamp}
		rsync -avh ${pathcount}/${current_datasheet} ${sv1files}/${nxtorhsq}/ZZ_10XG/arc/${run_name}${user_tag}_${timestamp}
		rsync -avh ${pathcount}/libraries_${1}.csv ${sv1files}/${nxtorhsq}/ZZ_10XG/arc/${run_name}${user_tag}_${timestamp}
		rsync -avh ${pathcount}/${1}_script_log.txt ${sv1files}/${nxtorhsq}/ZZ_10XG/arc/${run_name}${user_tag}_${timestamp}
		rsync -avh ${pathcount}/${1}_error_log.txt ${sv1files}/${nxtorhsq}/ZZ_10XG/arc/${run_name}${user_tag}_${timestamp} 2> /dev/null

		#md5 checksum
		find ${pathcount}/${1} -type f | sort | xargs md5sum | sed "s|$pathcount||" > ${pathcount}/${1}_md5_checksums.txt
		rsync -avh ${pathcount}/${1}_md5_checksums.txt ${sv1files}/${nxtorhsq}/ZZ_10XG/arc/${run_name}${user_tag}_${timestamp}

		
	fi

}


#############################
# EXTRACT SUMMARY METRICS
#############################

extract_summary_metrics () {

	# $1: $pathcount

	list_samples=$(find "$1" -maxdepth 1 -mindepth 1 -type d -not -name 'raw_metrics_folder' -printf '%f ')
	mkdir -p "${1}/raw_metrics_folder"
	metrics_folder=${1}/raw_metrics_folder
	mkdir -p "${metrics_folder}/GEX_only"
	mkdir -p "${metrics_folder}/ATAC_only"


	for current_sample_folder in ${list_samples}
	do
		# 1) Joint web summary — always present
		cp "${1}/${current_sample_folder}/outs/web_summary.html" "${metrics_folder}/"
		mv "${metrics_folder}/web_summary.html" \
		   "${metrics_folder}/${current_sample_folder}_web_summary.html"

		# 2) Joint metrics CSV — name differs by pipeline layout
		#    Multiome (arc) and CR>=v8:  summary.csv
		#    older GEX-only:             metrics_summary.csv
		metrics_src=""
		if [ -f "${1}/${current_sample_folder}/outs/summary.csv" ]; then
			metrics_src="${1}/${current_sample_folder}/outs/summary.csv"
		elif [ -f "${1}/${current_sample_folder}/outs/metrics_summary.csv" ]; then
			metrics_src="${1}/${current_sample_folder}/outs/metrics_summary.csv"
		else
			echo "  [warn] no summary.csv or metrics_summary.csv for ${current_sample_folder}" >&2
		fi
		if [ -n "$metrics_src" ]; then
			base=$(basename "$metrics_src")
			cp "$metrics_src" "${metrics_folder}/"
			mv "${metrics_folder}/${base}" "${metrics_folder}/${current_sample_folder}_${base}"
		fi

		# 3) Optional: cell-type web summary (present only in some pipelines)
		if [ -f "${1}/${current_sample_folder}/outs/cell_types/web_summary_cell_types.html" ]; then
			cp "${1}/${current_sample_folder}/outs/cell_types/web_summary_cell_types.html" "${metrics_folder}/"
			mv "${metrics_folder}/web_summary_cell_types.html" \
			   "${metrics_folder}/${current_sample_folder}_web_summary_cell_types.html"
		fi

		# 4) Optional: GEX-only internal web summary.
		#    Located by stage name under the arc CS tree, independent of the
		#    fork/join/chnk depth (ARC 2.2 adds a join/chnk level that the old
		#    cellranger-multi glob missed -- that is why GEX_only was empty).
		gex_web=$(find "${1}/${current_sample_folder}/SC_ATAC_GEX_COUNTER_CS/SC_ATAC_GEX_COUNTER/GEX_SUMMARIZE_REPORTS" -path '*/files/web_summary.html' -type f 2>/dev/null | head -1)
		if [ -n "$gex_web" ]; then
			cp "$gex_web" "${metrics_folder}/GEX_only/${current_sample_folder}_web_summary.html"
		else
			echo "  [warn] no GEX-only web_summary for ${current_sample_folder} (GEX_SUMMARIZE_REPORTS absent)" >&2
		fi

		# 5) Optional: ATAC-only internal web summary (same layout-robust lookup)
		atc_web=$(find "${1}/${current_sample_folder}/SC_ATAC_GEX_COUNTER_CS/SC_ATAC_GEX_COUNTER/_SC_ATAC_REPORTER/CREATE_WEBSUMMARY" -path '*/files/web_summary.html' -type f 2>/dev/null | head -1)
		if [ -n "$atc_web" ]; then
			cp "$atc_web" "${metrics_folder}/ATAC_only/${current_sample_folder}_web_summary.html"
		else
			echo "  [warn] no ATAC-only web_summary for ${current_sample_folder} (CREATE_WEBSUMMARY absent)" >&2
		fi

	done

	rsync -avh "${metrics_folder}" "${sv1files}/${nxtorhsq}/ZZ_10XG/arc/${run_name}${user_tag}_${timestamp}"


}



