datasheet_sampleq_var_def () {		#parse the datasheet file and define variables sample-related
	
	samplename=($(awk -v var=$currentsampleq 'BEGIN {FS="\t"};  $1 == var {print $2}' $1))
	samplename=$(echo $samplename | tr -d ' ')	#remove white spaces
	GEXlibrary_name=($(awk -v var=$currentsampleq 'BEGIN {FS="\t"};  $1 == var {print $3}' $1))
	GEXlibrary_name=$(echo $GEXlibrary_name | tr -d ' ')	#remove white spaces
	ATAClibrary_name=($(awk -v var=$currentsampleq 'BEGIN {FS="\t"};  $1 == var {print $4}' $1))
	ATAClibrary_name=$(echo $ATAClibrary_name | tr -d \' | tr -d ' ')	#remove single quote and white spaces
	bam_settings=($(awk -v var=$currentsampleq 'BEGIN {FS="\t"};  $1 == var {print $5}' $1))
	transcriptome=($(awk -v var=$currentsampleq 'BEGIN {FS="\t"};  $1 == var {print $6}' $1))
	transcriptome_custom=($(awk -v var=$currentsampleq 'BEGIN {FS="\t"};  $1 == var {print $7}' $1))
	transcriptome_custom=$(echo $transcriptome_custom | tr -d ' ')	#remove white spaces
	optional_argument=($(awk -v var=$currentsampleq 'BEGIN {FS="\t"};  $1 == var {print $8}' $1))
	optional_argument=$(echo $optional_argument | tr -d \" ) #remove quotes


	if test "$bam_settings" = 'FALSE';
	then
		bam_settings=false
	else
		bam_settings=true
	fi

	if [ -n "$transcriptome" ];
	then
		transcriptome=${transcriptome% (*)}
		#echo "Transcriptome: ${transcriptome}"
	fi

	transcriptome_custom_length=${#transcriptome_custom}	#defines the length of the string. since it save something even if the cell is empty but the tab is activated in txt file
	#echo $transcriptome_custom_length
					
	if [ "$transcriptome_custom_length" -gt '1' ] && [ "$transcriptome_custom" != 'no' ];
	then
		testpathfront_transcriptome_custom=${transcriptome_custom::1}	# defines the first charcater of the string
		testpathback_transcriptome_custom=${transcriptome_custom: -1}	# defines the last charcater of the string

		if [ "$transcriptome_custom_length" -gt '1' ] && [ "$testpathback_transcriptome_custom" != '/' ];	#adds / if absent
		then
			transcriptome_custom=${transcriptome_custom}/
		fi

		if [ "$transcriptome_custom_length" -gt '1' ] && [ "$testpathfront_transcriptome_custom" != '/' ];	#adds / if absent
		then
			transcriptome_custom=/${transcriptome_custom}
		fi

		echo "Custom transcriptome is present: ${transcriptome_custom}"

	fi

}

