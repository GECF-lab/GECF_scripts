datasheet_exp_var_def () {		#parse the datasheet file and define experiment variables

	#use datasheet_exp_var_def $current_datasheet

	run_name=$(awk 'BEGIN {FS="\t"}; /run_name/{print $3}' $1)
	run_name=$(echo $run_name | tr -d ' ')	#remove white spaces
	# username = first word of the sheet value; user_tag = "_<user>" or "" when blank
	username=$(awk 'BEGIN {FS="	"}; /user/{print $3; exit}' $1)
	username=${username%% *}
	user_tag=$([ -n "$username" ] && printf '_%s' "$username" || true)
	restrictions=$(awk 'BEGIN {FS="\t"}; /restrictions/{print $3}' $1)
	commandoutputonly=$(awk 'BEGIN {FS="\t"}; /commandoutputonly/{print $3}' $1)
	commandoutputonly=$(echo $commandoutputonly | tr -d ' ')	#remove white spaces
	commandoutputonlyfirstletter=${commandoutputonly:0:1}	#first letter of yes or no
	keepdata=$(awk 'BEGIN {FS="\t"}; /keepdata/{print $3}' $1)
	keepdata=$(echo $keepdata | tr -d ' ')	#remove white spaces
	GEXmanyfastq=$(awk 'BEGIN {FS="\t"}; /GEXmanyfastq/{print $3}' $1)
	GEXmanyfastq=$(echo $GEXmanyfastq | tr -d ' ')	#remove white spaces
	ATACmanyfastq=$(awk 'BEGIN {FS="\t"}; /GEXmanyfastq/{print $3}' $1)
	ATACmanyfastq=$(echo $ATACmanyfastq | tr -d ' ')	#remove white spaces

	nxtorhsq=${run_name::3}			#first three characters of run_name to understand if nxtseq or hiseq
	
	if test "$nxtorhsq" = 'AVT';
	then
		nxtorhsq=(AVT/AV240401)
	fi


	#if restrictions has value keep only the first word, otherwise unrestricted

	if [ -n "$restrictions" ];
	then
		restrictions=${restrictions%% *}
	else
		restrictions=(Unrestricted)

	fi

	if test "$restrictions" = 'Unrestricted';
	then
		numberofthreads=""
		numberofRAM=""
	else
 		numberofthreads=(--localcores=44) 
		numberofRAM=(--localmem=150)
	fi

}

datasheet_GEXmanyfastq_var_def () {	#parse the datasheet file and define define the fastq path

	GEXfastqpath1=$(awk 'BEGIN {FS="\t"}; /GEXfastqpath1/{print $3}' $1)
	GEXfastqpath1=$(echo $GEXfastqpath1 | tr -d ' ')	#remove white spaces
	GEXfastqpath1back=${GEXfastqpath1: -1}	# defines the last charcater of the string
	GEXfastqpath1front=${GEXfastqpath1::1}	# defines the first charcater of the string

	if [ "$GEXfastqpath1front" != '/' ];		#adds / in front if missing
	then
		GEXfastqpath1=/${GEXfastqpath1}
	fi

	if [ "$GEXfastqpath1back" = '/' ];		#removes / in the back if present
	then
		GEXfastqpath1=${GEXfastqpath1%/}
	fi

	GEXnxid=(${GEXfastqpath1}/*id*/${GEXlibrary_name}_S*_R1_001.fastq.gz)
	GEXnxid=${GEXnxid%/*}						#remove from Read1 the shortest match "/*" from the back
	GEXnxid=${GEXnxid##*/} 					#remove from nxid the shortest match "/*" from the front

	if [ "$GEXmanyfastq" -gt '1' ];
	then
		GEXnxid=${GEXnxid},etc...	#to say that there are multiple nxid
	fi

		
	GEXloopresults=$(for ((p=1; p<= $GEXmanyfastq; p++))
	do
		GEXfastqpath="\$GEXfastqpath$p"	#to escape $ symbol	
		GEXcurrentpath=($(awk -v var=$GEXfastqpath 'BEGIN {FS="\t"};  $1 == var {print $3}'  $1))
				
		GEXtestpathback=${GEXcurrentpath: -1}	# defines the last charcater of the string
		GEXtestpathfront=${GEXcurrentpath::1}	# defines the first charcater of the string

		if [ "$GEXtestpathfront" != '/' ];		#adds / in front if missing
		then
			GEXcurrentpath=/${GEXcurrentpath}
		fi
			
		if [ "$GEXtestpathback" = '/' ];		#removes / in the back if present
		then
			GEXcurrentpath=${GEXcurrentpath%/}
		fi

			
		GEXcompletecurrentpath=(${GEXcurrentpath}/*/${GEXlibrary_name}_S*_R1_001.fastq.gz)
		GEXcompletecurrentpath=${GEXcompletecurrentpath%/${GEXlibrary_name}*}
		GEXcompletecurrentpath=${GEXcompletecurrentpath}/
		echo $GEXcompletecurrentpath
				
	done)

	
	GEXtmploopresults=${GEXloopresults[@]}		#create a space delimited string from array
	GEXfastq_custom=${GEXtmploopresults// /,}		#use parameter expansion to substitute spaces with comma
}

